@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam ArrowColor #333333
skinparam classBackgroundColor #F5F8F8
skinparam classBorderColor #354F52
skinparam packageBackgroundColor #F5F8F8
skinparam packageBorderColor #354F52
skinparam sequenceParticipantBackgroundColor #F5F8F8
skinparam sequenceParticipantBorderColor #354F52
skinparam dpi 160
hide circle
skinparam classAttributeIconSize 0
class Product {
 -id : Long
 -version : Long
 -barcode : String
 -name : String
 -price : BigDecimal
 -stock : int
 -active : boolean
 +update(...)
 +decreaseStock(qty)
 +restoreStock(qty)
}
class Sale {
 -id : Long
 -checkoutKey : String
 -createdAt : LocalDateTime
 -total : BigDecimal
 -cashPaid : BigDecimal
 -changeDue : BigDecimal
 +addItem(product, qty)
 +recordPayment(cash)
 +getRefundedTotal()
}
class SaleItem {
 -id : Long
 -productName : String
 -barcode : String
 -unitPrice : BigDecimal
 -quantity : int
 -returnedQuantity : int
 +getSubtotal()
 +getReturnableQuantity()
 +recordReturn(qty)
}
class ReturnRecord {
 -id : Long
 -requestKey : String
 -quantity : int
 -refund : BigDecimal
 -reason : String
 -createdAt : LocalDateTime
}
Sale "1" *-- "1..*" SaleItem
SaleItem "0..*" --> "1" Product
ReturnRecord "0..*" --> "1" SaleItem

@enduml
